APP_NAME=2DriveScan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://2drivescan.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# The site has no database: sessions and cache live on disk.
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Addresses of the Cloudflare Tunnel connector (cloudflared), comma separated.
# Its X-Forwarded-* headers are trusted. Add its LAN address if it runs elsewhere.
TRUSTED_PROXIES=127.0.0.1,::1

# GitHub repository the downloads and release notes come from.
GITHUB_REPO=joostiphone/2drivescan
# Optional: a read-only token raises GitHub's API rate limit (60 → 5000 requests/hour).
GITHUB_TOKEN=
# How long release information is cached, in seconds.
RELEASES_CACHE_TTL=600
