[Unit]
Description=Record 2DriveScan download counts from GitHub for the statistics page
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
UMask=0002
WorkingDirectory=/var/www/2drivescan/current/website
ExecStart=/usr/bin/php artisan downloads:snapshot
